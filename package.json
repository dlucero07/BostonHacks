{
  "name": "on-the-go", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --import tsx --watch backend/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild backend/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js && esbuild backend/migrate.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/migrate.js",
    "start": "node dist/server.js", "test": "node --import tsx --test tests/*.test.ts", "typecheck": "tsc --noEmit", "db:migrate": "node --import tsx backend/migrate.ts"
  },
  "dependencies": {"@tailwindcss/vite":"^4.1.0","dotenv":"^17.0.0","express":"^5.1.0","express-rate-limit":"^8.0.0","helmet":"^8.1.0","lucide-react":"^0.468.0","pg":"^8.16.0","react":"^19.1.0","react-dom":"^19.1.0","zod":"^4.0.0"},
  "devDependencies": {"@types/express":"^5.0.0","@types/google.maps":"^3.58.0","@types/node":"^22.0.0","@types/pg":"^8.15.0","@types/react":"^19.1.0","@types/react-dom":"^19.1.0","@vitejs/plugin-react":"^4.5.0","concurrently":"^9.1.0","esbuild":"^0.25.0","tsx":"^4.19.0","typescript":"^5.8.0","vite":"^6.3.0"}
}
