# Copy this file to .env. Demo works without replacing anything.
APP_MODE=demo
PORT=3000
# PUBLIC: sent to the browser at runtime. Restrict to your domain + Maps JavaScript API / Places API (New).
GOOGLE_MAPS_BROWSER_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
GOOGLE_MAP_ID=YOUR_GOOGLE_MAP_ID
# SERVER ONLY: restrict by VM outbound IP + Routes API / Places API (New).
GOOGLE_MAPS_SERVER_KEY=YOUR_SERVER_RESTRICTED_GOOGLE_MAPS_KEY
# SERVER ONLY: Tiger Data PostgreSQL URI. Keep TLS verification enabled.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_TIGER_HOST:5432/YOUR_DATABASE?sslmode=verify-full
# Required in live mode. Demo may use bounded, ephemeral interaction storage.
REQUIRE_DATABASE=false
# Caddy: :80 for IP-only HTTP; your domain for automatic HTTPS.
SITE_ADDRESS=:80
# Optional, reserved for future Gemini preference parsing (not used by the MVP).
GEMINI_API_KEY=YOUR_OPTIONAL_GEMINI_API_KEY
